{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [],
  "redirects": [
    {
      "source": "/data/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.env",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/.env.local",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/:file(.*).pdf",
      "destination": "/404.html",
      "permanent": false
    },
    {
