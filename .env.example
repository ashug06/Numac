# Optional. Used only by the unused local /api/enquiry path. Never put a private inbox in HTML.
ENQUIRY_TO=

# Web3Forms Access Key (client-side, free plan). Destination inbox is set in the Web3Forms dashboard.
# npm run build / npm start write gitignored js/web3forms-access.js from this value.
# On Vercel, set WEB3FORMS_ACCESS_KEY in Project Settings so the build can generate that file.
WEB3FORMS_ACCESS_KEY=

# 2) Or Resend: https://resend.com
# RESEND_API_KEY=
# RESEND_FROM=Numac Healthcare <noreply@your-verified-domain>
